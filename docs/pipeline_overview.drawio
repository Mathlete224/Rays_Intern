<mxfile host="app.diagrams.net" type="device">
  <diagram id="pipeline-overview" name="Pipeline Overview">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="RAG Pipeline — High-Level Overview" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="30" width="420" height="30" as="geometry" />
        </mxCell>

        <!-- Box 1: User Prompt (top center) -->
        <mxCell id="userPrompt" value="User Prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="110" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Box 2: Prompt Classification (bottom left) -->
        <mxCell id="classification" value="Prompt Classification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="380" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Box 3: Prompt Handling (bottom right) -->
        <mxCell id="handling" value="Prompt Handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="380" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Edge: User Prompt -> Prompt Classification -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="userPrompt" target="classification">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Prompt Classification -> Prompt Handling -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="classification" target="handling">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Prompt Handling -> User Prompt (the loop / output) -->
        <mxCell id="e3" value="Output to user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="handling" target="userPrompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
